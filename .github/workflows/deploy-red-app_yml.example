# This is a basic workflow to help you get started with Actions

name: Deploy Red App

# Controls when the workflow will run
on:
  # Triggers the workflow on push or pull request events but only for the "main" branch
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# A workflow run is made up of one or more jobs that can run sequentially or in parallel
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      # Get code from repo
      - name: Checkout code
        uses: actions/checkout@v1
      # Install NodeJS
      - name: Setup Node.js environment
        uses: actions/setup-node@v3.4.1
      # Install and build rush
      - name: Install dependencies
        run: |
          cd monorepos/03_06_deploy
          node common/scripts/install-run-rush.js change -v
          node common/scripts/install-run-rush.js install
          node common/scripts/install-run-rush.js build
          node common/scripts/install-run-rush.js deploy --overwrite -p red-app
      # Run custom
      - name: Deploy to netlify
        uses: netlify/actions/cli@master
        env:
          NETLIFY_AUTH_TOKEN: ${{ secrets.NETLIFY__AUTH_TOKEN }}
          NETLIFY_SITE_ID: ${{ secrets.NETLIFY__SITE_ID }}

    
name: CI Workflow

# Triggers: When should this action run?
on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch: # Allows manual triggering from the GitHub UI

# Jobs: Tasks that run in parallel or sequence
jobs:
  build:
    runs-on: ubuntu-latest # Runs inside a clean Ubuntu Linux container

    steps:
      # Step 1: Pull your repository code into the container
      - name: Checkout code
        uses: actions/checkout@v4

      # Step 2: Run terminal commands inside the environment
      - name: Run a build test
        run: |
          echo "Running automated tasks for our monorepo"
          npm install